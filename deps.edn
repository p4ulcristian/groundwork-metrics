;; groundwork-metrics: groundwork's metrics. A meter the app makes once and hands to every
;; library; metrics declared as data, each label's values a closed set; the
;; text Prometheus pulls, behind a bearer token. One tree: source-code/groundwork_metrics/.
{:paths ["source-code"]

 :deps
 {;; the app's log, handed in: a value outside a label's set, a bad call
  io.github.p4ulcristian/groundwork-logs {:git/tag "v0.1.3" :git/sha "8d1846e"}
  ;; the route's bearer token, a secret that prints as its name
  io.github.p4ulcristian/groundwork-settings    {:git/tag "v0.1.2" :git/sha "25dfbf7"}
  ;; the settings, options and declarations, checked before anything counts
  metosin/malli                 {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests:  clojure -X:test
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
